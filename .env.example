# Server-side (Netlify function env). Optional: everything works without them in demo mode.
OPENAI_API_KEY=            # live product search (web search) + chat fallback
OPENROUTER_API_KEY=        # chat; preferred over OpenAI for chat if both are set
OPENAI_SEARCH_MODEL=       # default gpt-4.1-mini
OPENROUTER_MODEL=          # default openai/gpt-4.1-mini
OPENAI_CHAT_MODEL=         # default gpt-4.1-mini

# Client-side (must start with VITE_). Optional.
VITE_OOF_BASE_URL=         # OOF auth/authz base URL; unset = demo user

# Injected automatically by Netlify AI Gateway when enabled (do not set by hand):
# OPENAI_API_KEY + OPENAI_BASE_URL
